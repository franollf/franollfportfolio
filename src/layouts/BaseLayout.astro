---
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import profile from "../data/profile.json";
import { TABS, type TabKey } from "../data/tabs";

interface Props {
  active: TabKey;
}
const { active } = Astro.props;

const current = TABS.find((t) => t.key === active)!;
const titleFor = (t: (typeof TABS)[number]) => (t.key === "about" ? profile.title : `${t.label} — ${profile.name}`);
const canonical = new URL(current.path, Astro.site).href;
const ogImage = new URL(profile.about.portrait.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titleFor(current)}</title>
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#0f1a14" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titleFor(current)} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="assets/franoll-piskel-blinking.gif" type="image/gif" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") root.dataset.theme = theme;
        } catch (e) {}
        try {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!reduce && !sessionStorage.getItem("intro-seen")) {
            root.dataset.intro = "play";
            sessionStorage.setItem("intro-seen", "1");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-tab={active}>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="intro" aria-hidden="true">
      <div class="intro-card"><span class="intro-letter">F</span></div>
    </div>

    <header class="strip">
      <p class="crumb">
        <a class="crumb-name" href="/" data-tab-link="about">{profile.name}</a>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <span class="crumb-section"><span class="crumb-word">{current.label}</span></span>
      </p>

      <nav class="tabs" aria-label="Primary">
        <div class="tablist" role="tablist" aria-label="Sections">
          <span class="tab-pill" aria-hidden="true"></span>
          {
            TABS.map((t) => (
              <a
                class="tab"
                role="tab"
                id={`tab-${t.key}`}
                href={t.path}
                data-tab={t.key}
                data-label={t.label}
                data-title={titleFor(t)}
                aria-controls={`panel-${t.key}`}
                aria-selected={t.key === active ? "true" : "false"}
                tabindex={t.key === active ? 0 : -1}
              >
                <span class="dot" style={`--dot: ${t.dot}`} aria-hidden="true" />
                <span>{t.label}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <div class="strip-actions">
        <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        </button>
        <a class="btn btn--small strip-resume" href={profile.resume}>Resume</a>
      </div>
    </header>

    <main id="main" class="card" tabindex="-1">
      <div class="card-scroll">
        <slot />
      </div>
      <div class="card-cover" aria-hidden="true"><span class="card-letter">F</span></div>
    </main>

    <script>
      import "../scripts/intro.js";
      import "../scripts/theme.js";
      import "../scripts/tabs.js";
    </script>
  </body>
</html>
