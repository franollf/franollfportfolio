---
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import profile from "../data/profile.json";

const navs = [
  { href: "#projects", label: "Projects", dot: "var(--amber)" },
  { href: "#experience", label: "Experience", dot: "var(--moss)" },
  { href: "#about", label: "About", dot: "var(--terracotta)" },
  { href: "#contact", label: "Contact", dot: "var(--plum)" },
];
const github = profile.links.find((l) => l.label === "GitHub");
const linkedin = profile.links.find((l) => l.label === "LinkedIn");
const ogImage = new URL(profile.about.portrait.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.title}</title>
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#0f1a14" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={profile.title} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="assets/franoll-piskel-blinking.gif" type="image/gif" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") root.dataset.theme = theme;
        } catch (e) {}
        try {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!reduce && !location.hash && !sessionStorage.getItem("intro-seen")) {
            root.dataset.intro = "play";
            sessionStorage.setItem("intro-seen", "1");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="intro" aria-hidden="true">
      <div class="intro-card"><span class="intro-letter">F</span></div>
    </div>

    <header class="strip">
      <div class="strip-inner">
        <a class="brand" href="#top" aria-label="Franoll Fantu, back to top">
          <span class="brand-mark" aria-hidden="true">F</span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {
            navs.map((n) => (
              <a href={n.href}>
                <span class="dot" style={`--dot: ${n.dot}`} aria-hidden="true" />
                <span>{n.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="strip-actions">
          <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
          </button>
          <a class="btn btn--primary btn--small" href={profile.resume}>Resume</a>
          <button
            class="icon-btn hamburger"
            id="hamburger"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobileNav"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
      {
        navs.map((n) => (
          <a href={n.href} class="mobile-nav-link">
            <span class="dot" style={`--dot: ${n.dot}`} aria-hidden="true" />
            <span>{n.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="frame-corner tl" aria-hidden="true"></div>
    <div class="frame-corner tr" aria-hidden="true"></div>
    <div class="frame-corner bl" aria-hidden="true"></div>
    <div class="frame-corner br" aria-hidden="true"></div>
    <div class="frame-bottom" aria-hidden="true"></div>

    <main id="main" class="card" tabindex="-1">
      <slot />
    </main>

    <footer class="frame-footer" id="contact">
      <div class="container">
        <h2>{profile.contact.heading}</h2>
        <p>{profile.contact.text}</p>
        <div class="footer-links">
          <a href={`mailto:${profile.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            {profile.email}
          </a>
          {
            github && (
              <a href={github.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
                GitHub
              </a>
            )
          }
          {
            linkedin && (
              <a href={linkedin.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg>
                LinkedIn
              </a>
            )
          }
          <a href={profile.resume}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M9 14h6M9 17h4"></path></svg>
            Resume
          </a>
        </div>
        <p class="footer-meta">© <span id="year">{new Date().getFullYear()}</span> {profile.name}</p>
      </div>
    </footer>

    <script>
      import "../scripts/intro.js";
      import "../scripts/nav.js";
      import "../scripts/theme.js";
      import "../scripts/reveal.js";
    </script>
  </body>
</html>
