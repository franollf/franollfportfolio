---
import profile from "../data/profile.json";
---

<section id="top" class="hero container" aria-labelledby="hero-name">
  <div class="hero-text">
    <p class="hero-greeting">{profile.greeting}</p>
    <h1 id="hero-name">{profile.name}</h1>
    <p class="hero-bio">
      {
        profile.bio.map((part) =>
          part.href ? (
            <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a>
          ) : (
            <Fragment>{part.text}</Fragment>
          )
        )
      }
    </p>
    <ul class="hero-stack" aria-label="Tech stack — select one to see projects using it">
      {
        profile.heroStack.map((tech) => (
          <li>
            <button
              class="stack-icon stack-chip"
              type="button"
              data-tech={tech.name}
              aria-pressed="false"
              aria-label={tech.name}
              title={tech.name}
            >
              <img src={tech.icon} alt="" width="30" height="30" />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
  <img
    class="hero-art"
    src={profile.avatar.src}
    alt="Pixel-art avatar of Franoll"
    width={profile.avatar.width}
    height={profile.avatar.height}
  />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    min-height: calc(100svh - var(--strip) - var(--gap));
    padding-block: 3rem;
  }

  .hero-greeting {
    font-size: 1.05rem;
    color: var(--muted);
  }

  h1 {
    margin-top: 0.35rem;
    font-size: clamp(2.6rem, 1.8rem + 3.5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-bio {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink);
  }

  .hero-bio a {
    color: var(--moss-ink);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .hero-bio a:hover {
    text-decoration-style: solid;
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.75rem;
  }

  .stack-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .stack-icon img {
    filter: grayscale(1) contrast(1.2);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .stack-icon:hover,
  .stack-icon:focus-visible,
  .stack-icon[aria-pressed="true"] {
    transform: translateY(-3px);
    background: var(--card-raised);
  }

  .stack-icon:hover img,
  .stack-icon:focus-visible img,
  .stack-icon[aria-pressed="true"] img {
    filter: none;
    opacity: 1;
  }

  .hero-art {
    width: clamp(180px, 10rem + 10vw, 320px);
    height: auto;
    image-rendering: pixelated;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 1.5rem;
      min-height: calc(100svh - var(--strip) - var(--gap) - 4rem);
      padding-block: 2.5rem;
    }

    .hero-stack {
      gap: 0.15rem;
    }

    .stack-icon {
      width: 42px;
      height: 42px;
    }

    .stack-icon img {
      width: 26px;
      height: 26px;
    }

    .hero-art {
      grid-row: 1;
      width: 96px;
    }
  }
</style>
