---
interface Props {
  id: string;
  title: string;
  accent: "projects" | "experience" | "about" | "contact";
}
const { id, title, accent } = Astro.props;
---

<section id={id} class={`section container accent-${accent}`} aria-labelledby={`${id}-title`}>
  <div class="section-header">
    <h2 id={`${id}-title`}>{title}</h2>
  </div>
  <slot />
</section>
