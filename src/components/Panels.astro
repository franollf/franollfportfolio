---
import type { TabKey } from "../data/tabs";
import AboutPanel from "./AboutPanel.astro";
import Timeline from "./Timeline.astro";
import ProjectStack from "./ProjectStack.astro";

interface Props {
  active: TabKey;
}
const { active } = Astro.props;
---

<section id="panel-about" class="panel panel-about" role="tabpanel" aria-labelledby="tab-about" hidden={active !== "about"}>
  <AboutPanel />
</section>
<!-- /panel-about -->
<section id="panel-experience" class="panel panel-experience" role="tabpanel" aria-labelledby="tab-experience" hidden={active !== "experience"}>
  <h2 class="visually-hidden">Experience</h2>
  <div class="container panel-pad exp-wrap"><Timeline /></div>
</section>
<!-- /panel-experience -->
<section id="panel-projects" class="panel panel-projects" role="tabpanel" aria-labelledby="tab-projects" hidden={active !== "projects"}>
  <h2 class="visually-hidden">Projects</h2>
  <div class="container panel-pad pj-wrap"><ProjectStack /></div>
</section>
<!-- /panel-projects -->
