---
import projects from "../data/projects.json";

type Project = (typeof projects)[number];

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const counts = new Map<string, number>();
projects.forEach((p) => p.tags.forEach((t) => counts.set(t.name, (counts.get(t.name) ?? 0) + 1)));
const filters = [...counts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, n]) => ({ name, key: slug(name), n }));

const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const GH =
  "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z";
const groups: { label: string; items: Project[]; cls: string }[] = [
  { label: "Featured", items: featured, cls: "grid-featured" },
  { label: "More projects", items: more, cls: "grid-more" },
];
---

<div class="projects">
  <div class="filters" role="group" aria-label="Filter projects by technology">
    <button type="button" class="filter" data-filter="all" aria-pressed="true">All <span class="n">{projects.length}</span></button>
    {
      filters.map((f) => (
        <button type="button" class="filter" data-filter={f.key} aria-pressed="false">
          {f.name} <span class="n">{f.n}</span>
        </button>
      ))
    }
  </div>
  <p class="filter-status" role="status" aria-live="polite"></p>

  {
    groups.map((g) => (
      <div class="project-group" data-group>
        <h3 class="group-label">{g.label}</h3>
        <div class={`project-grid ${g.cls}`}>
          {g.items.map((p, i) => (
            <article
              class="project reveal"
              data-project={p.slug}
              data-tags={p.tags.map((t) => slug(t.name)).join(" ")}
              style={`view-transition-name: project-${p.slug}`}
            >
              <div class="project-media">
                <img
                  class={p.image.class ?? "project-preview"}
                  src={p.image.src}
                  srcset={p.image.srcset}
                  sizes={p.image.srcset ? "(min-width: 1100px) 340px, (min-width: 700px) 45vw, 92vw" : undefined}
                  alt={p.image.alt}
                  width={p.image.width}
                  height={p.image.height}
                  loading={g.cls === "grid-featured" && i === 0 ? "eager" : "lazy"}
                  fetchpriority={g.cls === "grid-featured" && i === 0 ? "high" : undefined}
                />
              </div>
              <div class="project-body">
                {p.badges.length > 0 && (
                  <ul class="badges" aria-label="Badges">
                    {p.badges.map((b) => <li class="badge">{b}</li>)}
                  </ul>
                )}
                <div class="project-title-row">
                  <h3 class="project-title">{p.title}</h3>
                  <div class="project-links">
                    <a href={p.github} target="_blank" rel="noopener noreferrer" aria-label={`View ${p.title} on GitHub`}>
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d={GH} /></svg>
                    </a>
                    {p.demo && (
                      <a href={p.demo} target="_blank" rel="noopener noreferrer" aria-label={`Watch the ${p.title} demo`}>
                        <span class="demo-icon" aria-hidden="true">▶</span>
                      </a>
                    )}
                  </div>
                </div>
                {p.meta && <p class="project-meta">{p.meta}</p>}
                <p class="project-desc">{p.description}</p>
                <ul class="tags" aria-label="Tech stack">
                  {p.tags.map((t) => (
                    <li class="chip">
                      {t.icon && <img src={t.icon} alt="" width="14" height="14" loading="lazy" />}
                      {t.name}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  import "../scripts/projects.js";
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card-raised);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .filter .n {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .filter:hover {
    border-color: var(--amber);
  }

  .filter[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--card);
  }

  .filter[aria-pressed="true"] .n {
    color: inherit;
    opacity: 0.75;
  }

  .filter-status:empty {
    display: none;
  }

  .filter-status {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .project-group + .project-group {
    margin-top: 2.5rem;
  }

  .group-label {
    margin: 1.25rem 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-ink);
  }

  .project-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 700px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .grid-featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grid-more {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--card-raised);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .project:hover,
  .project:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--amber) 60%, var(--rule));
    box-shadow: 0 12px 28px -14px rgb(15 26 20 / 0.45);
  }

  .project-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--card);
  }

  .project-media img {
    width: 100%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project:hover .project-media img {
    transform: scale(1.05);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.1rem 1.15rem;
  }

  .badges {
    display: flex;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--amber) 22%, transparent);
    color: var(--amber-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-title {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .grid-more .project-title {
    font-size: 1.05rem;
  }

  .project-links {
    display: flex;
    gap: 0.35rem;
    flex: none;
  }

  .project-links a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .project-links a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--card);
  }

  .demo-icon {
    font-size: 0.85rem;
    transform: translateX(1px);
  }

  .project-meta {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber-ink);
  }

  .project-desc {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .project[hidden],
  .project-group[hidden] {
    display: none;
  }
</style>
